# Porta da API NestJS
PORT=3000

# Tempo (ms) de tolerância de desconexão antes de remover o jogador da sala.
# Se o usuário reconectar dentro desse prazo (ex.: reload da página),
# a sessão é reatribuída sem duplicar. Default: 60000 (1 min).
POKER_DISCONNECT_TIMEOUT_MS=60000

# Token pessoal da API do ClickUp (https://app.clickup.com/settings/apps).
# Usado para buscar automaticamente o título da tarefa a partir do link.
CLICKUP_API_TOKEN=pk_88168382_E970CJ5NHFXFH9U65U9BPRWULY9NUKG0
